# ============================================================================
# TongaPass — variables d'environnement
# Ne mettez JAMAIS de vrai secret dans ce fichier : il est versionné.
# Générez votre .env local avec :  node scripts/init-env.mjs
# Chaque valeur « __GENERATE__ » est remplacée par un secret aléatoire fort.
# ============================================================================

# Profils Docker Compose actifs (« chat » = Mattermost). Videz pour un déploiement allégé.
COMPOSE_PROFILES=chat
CHAT_ENABLED=true

# --- URLs publiques (navigateur) -------------------------------------------
PORTAL_URL=http://localhost:8088
PUBLIC_API_URL=http://localhost:4100
KEYCLOAK_PUBLIC_URL=http://localhost:8180
N8N_PUBLIC_URL=http://localhost:5678
GITEA_PUBLIC_URL=http://localhost:3300
MATTERMOST_PUBLIC_URL=http://localhost:8065
MAILPIT_PUBLIC_URL=http://localhost:8025

# --- Entreprise --------------------------------------------------------------
COMPANY_NAME=TongaPass
COMPANY_EMAIL_DOMAIN=tongapass.local
HR_NOTIFICATION_EMAIL=rh@tongapass.local
MAIL_FROM="TongaPass <bienvenue@tongapass.local>"

# --- PostgreSQL (un utilisateur par service) --------------------------------
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
TP_DB_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
N8N_DB_PASSWORD=__GENERATE__
GITEA_DB_PASSWORD=__GENERATE__
MATTERMOST_DB_PASSWORD=__GENERATE__

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
# Secret du compte de service utilisé par n8n (client tongapass-provisioner)
# Secret du compte de service en lecture seule (contrôle de conformité)
TP_AUDITOR_SECRET=__GENERATE__
TP_PROVISIONER_SECRET=__GENERATE__
# Mot de passe commun des comptes de démonstration admin.it / rh.manager / auditeur
TP_DEMO_PASSWORD=__GENERATE_DEMO__

# --- Automatisation (API <-> n8n) -------------------------------------------
N8N_WEBHOOK_TOKEN=__GENERATE__
AUTOMATION_HMAC_SECRET=__GENERATE__
N8N_ENCRYPTION_KEY=__GENERATE__
N8N_OWNER_EMAIL=admin@tongapass.local
N8N_OWNER_PASSWORD=__GENERATE_DEMO__

# --- Gitea -------------------------------------------------------------------
GITEA_ADMIN_USER=tp-provisioner
GITEA_ADMIN_PASSWORD=__GENERATE__
GITEA_SECRET_KEY=__GENERATE__

# --- Mattermost --------------------------------------------------------------
MATTERMOST_ADMIN_USER=tp-provisioner
MATTERMOST_ADMIN_PASSWORD=__GENERATE_DEMO__
